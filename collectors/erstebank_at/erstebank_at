#!/bin/bash
# Host-side wrapper around `docker run` for the erstebank_at container.
# Mounts ~/.secrets/ (RW; persistent Camoufox profile + env file), the
# bronze tree (RW), and a /debug dir for explore artefacts. Single-writer:
# a sign-in waiting on a George app push can't tolerate a concurrent
# invocation, and the safety guard refuses to evict a container hosting a
# live VNC session.
#
# The collector is at its discovery stage: `explore` records a George
# session driven by hand over VNC (DESIGN.md §2-§3), and `prune` reclaims
# its captures host-side. `login`, `download` and `load` are accepted so an
# orchestrator's login → download → load parses, and say they are not built
# yet. No trust survives the browser, so `login` will fold into
# `download` (DESIGN.md §F, §4).
#
# The common docker-run plumbing lives in shared/wrappers/wrapper-lib.sh.

set -euo pipefail

NAME=erstebank_at
ENV_PREFIX=ERSTEBANK_AT
ENV_VARS=(ERSTEBANK_AT_USERNAME)
HAS_DEBUG=1
HAS_APP_MOUNT=1     # the checkout's source over /app on every verb
HAS_SAFETY=1        # refuse to evict a live container mid-push / mid-VNC
HAS_VNC=1           # forward a free 5900-6000 port
VNC_SUBCOMMANDS=(explore)   # the browser-over-VNC verbs

HERE="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
source "$HERE/../../shared/wrappers/wrapper-lib.sh"
wrapper_init

if [[ "${1:-}" == "build" ]]; then
    wrapper_build "$@"
fi

if [[ "${1:-}" == "help" || "${1:-}" == "--help" || "${1:-}" == "-h" || $# -eq 0 ]]; then
    cat <<EOF
erstebank_at — host wrapper

Read-only collector for George, the retail e-banking portal of Erste Bank
und Sparkassen in Austria (george.sparkasse.at): checking accounts
(Girokonto) and credit cards, their transaction history, and statement
PDFs. It is at its discovery stage: only \`explore\` and \`prune\` run.

Subcommands:
  build               Build the Docker image (\`docker build\`).
  explore [args...]   Discovery harness: Camoufox over VNC + HAR / network
                      log / click log / DOM snapshots / response bodies
                      under /debug. Sign-in and the George approval are
                      done by hand. --fresh wipes the profile so the next
                      sign-in takes the unknown-device path.
  login [args...]     Not built yet (exits 2).
  download [args...]  Not built yet (exits 2).
  load [args...]      Not built yet (exits 2).
  prune [args...]     Delete non-complete dumps from the bronze tree, and
                      aged entries of the /debug cache (runs host-side).
                      --dry-run prints the plan.
  sh|bash             Open an interactive shell in the container.
  help                Show this message.

Mounted into the container:
$(wrapper_mounts_help)

Override mounts via env:
  ERSTEBANK_AT_SECRETS_DIR=/path/to/secrets
  ERSTEBANK_AT_DATA_DIR=/path/to/data
  ERSTEBANK_AT_DEBUG_DIR=/path/to/debug

Credentials (read from /secrets/erstebank_at.env inside the container
= \$HOME/.secrets/erstebank_at.env on the host; chmod 0600):
  ERSTEBANK_AT_USERNAME   the George user name (Verfügernummer or alias)
  The sign-in is confirmed in the George app.
EOF
    exit 0
fi

# prune runs host-side (wrapper_host_prune).
if [[ "${1:-}" == "prune" ]]; then
    wrapper_host_prune "$@"
fi

wrapper_main "$@"
